# --- CMS switch ---
# Leave false to run the frontend on placeholder data (no Postgres needed).
# Set to true once DATABASE_URL works and you want Payload + the admin.
USE_CMS=false

# --- Required ---
# Postgres (Neon, Supabase, Railway, or local via docker-compose)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/event_site
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public URL of the site (used for Stripe redirects + metadata)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Timezone event dates are shown in
NEXT_PUBLIC_SITE_TIMEZONE=America/New_York

# --- Stripe ticketing (optional until you're ready to sell) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Image storage (optional; local disk is used when unset) ---
# Cloudflare R2 example: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
